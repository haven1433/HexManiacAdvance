<UserControl x:Class="HavenSoft.HexManiac.WPF.Controls.CharacterCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hshmwpfc="clr-namespace:HavenSoft.HexManiac.WPF.Controls"
             SizeChanged="ControlSizeChanged">
   <UserControl.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
      <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
         <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
         <Setter Property="TextWrapping" Value="Wrap"/>
         <Setter Property="Margin" Value="0,2"/>
      </Style>
      <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
         <Setter Property="Padding" Value="10,2"/>
         <Setter Property="Margin" Value="0,0,6,4"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
         <Setter Property="BorderBrush" Value="{DynamicResource Backlight}"/>
         <Setter Property="BorderThickness" Value="1"/>
         <Setter Property="Padding" Value="8"/>
         <Setter Property="Margin" Value="0,0,10,10"/>
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
         <Setter Property="FontSize" Value="16"/>
         <Setter Property="FontWeight" Value="Bold"/>
         <Setter Property="Margin" Value="0,0,0,2"/>
      </Style>

      <!-- one tile of the 'everything at a glance' grids: the boy and the girl wearing one skin tone or clothes colour -->
      <DataTemplate x:Key="GridTile">
         <Border BorderThickness="2" Margin="0,0,6,6">
            <Border.Style>
               <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Style.Triggers>
                     <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                     </DataTrigger>
                  </Style.Triggers>
               </Style>
            </Border.Style>
            <Button Command="{Binding Select}" Padding="4" ToolTip="{Binding Name}">
               <StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                     <hshmwpfc:PixelImage DataContext="{Binding Boy}" UseTrueTransparency="True"/>
                     <hshmwpfc:PixelImage DataContext="{Binding Girl}" UseTrueTransparency="True" Margin="4,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" MaxWidth="84" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" FontSize="11"/>
               </StackPanel>
            </Button>
         </Border>
      </DataTemplate>
   </UserControl.Resources>

   <!--
      Wide: the colour lists on the left, the previews on the right, each column scrolling on its own (so the previews stay in sight while a colour is edited).
      Narrow (CharacterCustomizationTab.UseTwoColumns): the code behind moves both columns into PageStack, one under the other, and the whole tab scrolls as one.
   -->
   <Grid Background="{DynamicResource Background}">
      <Grid x:Name="Columns">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <ScrollViewer x:Name="LeftScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LeftColumn" Margin="12,8,2,8" HorizontalAlignment="Left" Width="452">

               <!-- ============ header ============ -->
               <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Refresh}" Padding="8,1" VerticalAlignment="Top" ToolTip="Read everything from the ROM again"/>
                  <StackPanel>
                     <TextBlock Text="Character Customization" FontSize="18"/>
                     <TextBlock Text="{Binding Introduction}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left"/>
                  </StackPanel>
               </DockPanel>

               <!-- ============ the two lists ============ -->
               <ItemsControl ItemsSource="{Binding Lists}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <Border Style="{StaticResource Card}" MaxWidth="440" HorizontalAlignment="Left">
                           <DockPanel>
                              <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                              <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Hint}"/>

                              <!-- a counter that doesn't match its table, or a table that can't be read: say so, and offer the fix -->
                              <Border DockPanel.Dock="Top" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}" Background="#33FFB000" Padding="6" Margin="0,4">
                                 <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Fix" Command="{Binding FixCount}" Margin="6,0,0,0" Padding="12,2" VerticalAlignment="Center" ToolTip="Make the counter the game reads match the table"/>
                                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"/>
                                 </DockPanel>
                              </Border>

                              <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                                 <Button Content="Add" Command="{Binding Add}" Style="{StaticResource ToolButton}" ToolTip="Add a new row at the end (it starts as a copy of the selected colours)"/>
                                 <Button Content="Copy" Command="{Binding Duplicate}" Style="{StaticResource ToolButton}" ToolTip="Add a copy of the selected row at the end"/>
                                 <Button Content="Remove" Command="{Binding Remove}" Style="{StaticResource ToolButton}" ToolTip="Remove the selected row. Rows after it move up by one. Row 0 can't be removed."/>
                                 <Button Content="Move up" Command="{Binding MoveUp}" Style="{StaticResource ToolButton}" ToolTip="Swap the selected row with the one above it"/>
                                 <Button Content="Move down" Command="{Binding MoveDown}" Style="{StaticResource ToolButton}" ToolTip="Swap the selected row with the one below it"/>
                                 <Button Content="Open table" Command="{Binding OpenTable}" Style="{StaticResource ToolButton}" ToolTip="Show this list's table in the main tab"/>
                              </WrapPanel>

                              <!-- the colours of the selected row -->
                              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Backlight}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                                 <StackPanel>
                                    <TextBlock Text="{Binding SelectedTitle}" TextWrapping="Wrap" FontWeight="Bold"/>
                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisible}}">
                                       <TextBlock Style="{StaticResource Hint}" Text="Click a colour to change it (main, shadow, highlight). Colours are saved the way the game stores them: 0 to 31 per channel. Drag a colour to swap places."/>
                                       <Grid HorizontalAlignment="Left" Margin="0,6,0,6">
                                          <Grid.LayoutTransform>
                                             <ScaleTransform ScaleX="2" ScaleY="2"/>
                                          </Grid.LayoutTransform>
                                          <hshmwpfc:PaletteControl DataContext="{Binding Palette}" ShowToolButtons="False" HorizontalAlignment="Left"/>
                                       </Grid>
                                       <TextBlock Text="{Binding ColorSummary}" Style="{StaticResource Hint}"/>
                                       <Button Content="Make shadow and highlight from main" Command="{Binding DeriveShadeCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                               ToolTip="Keep the main colour and fill in a darker shadow and a lighter highlight to match"/>
                                    </StackPanel>
                                 </StackPanel>
                              </Border>

                              <!-- the rows: number, three colours, name -->
                              <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                 <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                          <Border BorderThickness="2" Margin="0,0,0,2" Padding="4,2" Cursor="Hand" Loaded="RowLoaded" PreviewMouseLeftButtonDown="RowPressed">
                                             <Border.Style>
                                                <Style TargetType="Border">
                                                   <Setter Property="BorderBrush" Value="Transparent"/>
                                                   <Setter Property="Background" Value="Transparent"/>
                                                   <Style.Triggers>
                                                      <DataTrigger Binding="{Binding Selected}" Value="True">
                                                         <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                         <Setter Property="Background" Value="{DynamicResource Backlight}"/>
                                                      </DataTrigger>
                                                   </Style.Triggers>
                                                </Style>
                                             </Border.Style>
                                             <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="28" Text="{Binding Index}" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Main, shadow and highlight">
                                                   <StackPanel.Style>
                                                      <Style TargetType="StackPanel">
                                                         <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                               <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                         </Style.Triggers>
                                                      </Style>
                                                   </StackPanel.Style>
                                                   <Rectangle Width="22" Height="18" Fill="{Binding Main, Converter={StaticResource PaletteColorConverter}}"/>
                                                   <Rectangle Width="22" Height="18" Fill="{Binding Shadow, Converter={StaticResource PaletteColorConverter}}"/>
                                                   <Rectangle Width="22" Height="18" Fill="{Binding Highlight, Converter={StaticResource PaletteColorConverter}}"/>
                                                </StackPanel>
                                                <Grid VerticalAlignment="Center">
                                                   <TextBox Text="{Binding Name, Mode=OneWay}" MaxLength="15" LostKeyboardFocus="NameLostFocus" KeyDown="NameKeyDown"
                                                            ToolTip="Click to rename (up to 15 characters), then press Enter">
                                                      <TextBox.Style>
                                                         <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Style.Triggers>
                                                               <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                               </DataTrigger>
                                                            </Style.Triggers>
                                                         </Style>
                                                      </TextBox.Style>
                                                   </TextBox>
                                                   <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Secondary}" FontStyle="Italic">
                                                      <TextBlock.Style>
                                                         <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                               <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible"/>
                                                               </DataTrigger>
                                                            </Style.Triggers>
                                                         </Style>
                                                      </TextBlock.Style>
                                                   </TextBlock>
                                                </Grid>
                                             </DockPanel>
                                          </Border>
                                       </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                              </ScrollViewer>
                           </DockPanel>
                        </Border>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>

            </StackPanel>
         </ScrollViewer>

         <ScrollViewer x:Name="RightScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RightColumn" Margin="2,8,2,8">

               <!-- ============ the previews ============ -->
               <Border Style="{StaticResource Card}">
                  <StackPanel>
                     <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                           <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                           <Slider Width="100" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Zoom}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                     </DockPanel>
                     <TextBlock Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left" Text="{Binding PreviewHint}"/>
                     <!-- the boy and the girl: side by side when there is room -->
                     <ItemsControl ItemsSource="{Binding Panels}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                           <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                           </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                           <DataTemplate>
                              <StackPanel Margin="0,6,24,0">
                                 <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"/>
                                 <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <!-- standing still, facing down, up and left (no walking frames) -->
                                    <ItemsControl ItemsSource="{Binding OverworldFrames}" IsTabStop="False" VerticalAlignment="Top">
                                       <ItemsControl.ItemsPanel>
                                          <ItemsPanelTemplate>
                                             <StackPanel Orientation="Horizontal"/>
                                          </ItemsPanelTemplate>
                                       </ItemsControl.ItemsPanel>
                                       <ItemsControl.ItemTemplate>
                                          <DataTemplate>
                                             <StackPanel Margin="0,0,8,6">
                                                <Border Background="{DynamicResource Backlight}" Padding="2" HorizontalAlignment="Center">
                                                   <hshmwpfc:PixelImage DataContext="{Binding Image}" UseTrueTransparency="True"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                             </StackPanel>
                                          </DataTemplate>
                                       </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="6,0,14,6" VerticalAlignment="Top">
                                       <Border Background="{DynamicResource Backlight}" Padding="2" HorizontalAlignment="Center">
                                          <hshmwpfc:PixelImage DataContext="{Binding Front}" UseTrueTransparency="True"/>
                                       </Border>
                                       <TextBlock Text="trainer picture" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,6" VerticalAlignment="Top">
                                       <Border Background="{DynamicResource Backlight}" Padding="2" HorizontalAlignment="Center">
                                          <hshmwpfc:PixelImage DataContext="{Binding Back}" UseTrueTransparency="True"/>
                                       </Border>
                                       <TextBlock Text="back picture" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                 </WrapPanel>
                              </StackPanel>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                  </StackPanel>
               </Border>

               <!-- ============ the pictures ============ -->
               <Border Style="{StaticResource Card}">
                  <StackPanel>
                     <TextBlock Text="Edit the character's pictures" Style="{StaticResource SectionTitle}"/>
                     <TextBlock Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left" Text="{Binding PictureHint}"/>
                     <ItemsControl ItemsSource="{Binding Panels}" IsTabStop="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                           <DataTemplate>
                              <WrapPanel Orientation="Horizontal">
                                 <Button Content="{Binding EditOverworldText}" Command="{Binding EditOverworld}" Style="{StaticResource ToolButton}" ToolTip="Open every picture of the walking sheet (standing, walking, running) in the image editor: the dots on its left choose the picture"/>
                                 <Button Content="{Binding EditFrontText}" Command="{Binding EditFront}" Style="{StaticResource ToolButton}" ToolTip="Open the trainer front picture in the image editor"/>
                                 <Button Content="{Binding EditBackText}" Command="{Binding EditBack}" Style="{StaticResource ToolButton}" ToolTip="Open the back picture in the image editor"/>
                              </WrapPanel>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                  </StackPanel>
               </Border>

               <!-- ============ everything at a glance ============ -->
               <Border Style="{StaticResource Card}">
                  <StackPanel>
                     <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Show all" IsChecked="{Binding ShowAllPreviews}" VerticalAlignment="Center" ToolTip="Show every skin tone and every clothes colour at once"/>
                        <TextBlock Text="Everything at a glance" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                     </DockPanel>
                     <TextBlock Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left" Text="{Binding GlanceHint}"/>
                     <TextBlock Text="Skin tones" FontWeight="Bold" Margin="0,6,0,2"/>
                     <ItemsControl ItemsSource="{Binding SkinGrid}" ItemTemplate="{StaticResource GridTile}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                           <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                           </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                     </ItemsControl>
                     <TextBlock Text="Clothes colours" FontWeight="Bold" Margin="0,6,0,2"/>
                     <ItemsControl ItemsSource="{Binding ClothesGrid}" ItemTemplate="{StaticResource GridTile}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                           <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                           </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                     </ItemsControl>
                     <StackPanel Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Secondary colours (the red parts)" FontWeight="Bold" Margin="0,6,0,2"/>
                        <ItemsControl ItemsSource="{Binding SecondaryGrid}" ItemTemplate="{StaticResource GridTile}" IsTabStop="False">
                           <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                 <WrapPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                           </ItemsControl.ItemsPanel>
                        </ItemsControl>
                     </StackPanel>
                  </StackPanel>
               </Border>

               <!-- ============ how the game uses the colours ============ -->
               <Border Style="{StaticResource Card}">
                  <StackPanel>
                     <TextBlock Text="How the game uses these colours" Style="{StaticResource SectionTitle}"/>
                     <ItemsControl ItemsSource="{Binding RoleLines}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                           <DataTemplate>
                              <TextBlock Text="{Binding}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left"/>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                     <TextBlock Text="{Binding HighlightNote}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left"/>
                     <WrapPanel Margin="0,6,0,0">
                        <Button Content="Open skin table" Command="{Binding OpenSkinTable}" Style="{StaticResource ToolButton}" ToolTip="Show the skin tone table in the main tab"/>
                        <Button Content="Open clothes table" Command="{Binding OpenClothesTable}" Style="{StaticResource ToolButton}" ToolTip="Show the clothes colour table in the main tab"/>
                        <Button Content="Open secondary table" Command="{Binding OpenSecondaryTable}" Style="{StaticResource ToolButton}" ToolTip="Show the secondary colour table (the red parts) in the main tab"
                                Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisible}}"/>
                        <Button Content="Open roles table" Command="{Binding OpenRolesTable}" Style="{StaticResource ToolButton}" ToolTip="Show the table that says which palette slots get painted"/>
                     </WrapPanel>
                  </StackPanel>
               </Border>
            </StackPanel>
         </ScrollViewer>
      </Grid>

      <ScrollViewer x:Name="PageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel x:Name="PageStack"/>
      </ScrollViewer>
   </Grid>
</UserControl>
