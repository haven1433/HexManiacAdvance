<UserControl x:Class="HavenSoft.HexManiac.WPF.Controls.IntroManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hshmwpfc="clr-namespace:HavenSoft.HexManiac.WPF.Controls"
             xmlns:hshmcvm="clr-namespace:HavenSoft.HexManiac.Core.ViewModels;assembly=HexManiac.Core">
   <UserControl.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
      <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
         <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
         <Setter Property="TextWrapping" Value="Wrap"/>
         <Setter Property="Margin" Value="0,2"/>
      </Style>
      <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
         <Setter Property="Padding" Value="10,2"/>
         <Setter Property="Margin" Value="0,0,6,4"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
         <Setter Property="BorderBrush" Value="{DynamicResource Backlight}"/>
         <Setter Property="BorderThickness" Value="1"/>
         <Setter Property="Padding" Value="10"/>
         <Setter Property="Margin" Value="0,0,10,10"/>
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
         <Setter Property="FontSize" Value="16"/>
         <Setter Property="FontWeight" Value="Bold"/>
         <Setter Property="Margin" Value="0,0,0,2"/>
      </Style>
      <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
         <Setter Property="FontSize" Value="13"/>
         <Setter Property="FontWeight" Value="Bold"/>
         <Setter Property="Margin" Value="0,8,0,2"/>
      </Style>

      <!-- a message under a field: plain when it only says what changed, on a yellow background when something is wrong -->
      <Style x:Key="StatusBox" TargetType="Border">
         <Setter Property="Padding" Value="0,2"/>
         <Setter Property="Margin" Value="0,4,0,0"/>
         <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
               <Setter Property="Background" Value="#33FFB000"/>
               <Setter Property="Padding" Value="6"/>
            </DataTrigger>
         </Style.Triggers>
      </Style>

      <!-- a search box above a drop down list: typing in the box shortens the list; greyed out entries can't be stored by the game's code (point at one to see why) -->
      <DataTemplate x:Key="OptionPicker">
         <StackPanel>
            <TextBlock Text="Search (a part of a name or a number)" Style="{StaticResource Hint}"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type part of a name or a number to shorten the list below"/>
            <TextBlock Text="{Binding MatchText}" Style="{StaticResource Hint}"/>
            <ComboBox ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}" MaxDropDownHeight="360" IsTextSearchEnabled="True" TextSearch.TextPath="Text" MinWidth="260">
               <ComboBox.ItemTemplate>
                  <DataTemplate>
                     <TextBlock Text="{Binding Text}" ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True"/>
                  </DataTemplate>
               </ComboBox.ItemTemplate>
               <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                     <Setter Property="IsEnabled" Value="{Binding Available}"/>
                  </Style>
               </ComboBox.ItemContainerStyle>
            </ComboBox>
         </StackPanel>
      </DataTemplate>

      <!-- one setting: the Pokémon of the speech, a song, the cry of the title screen -->
      <DataTemplate x:Key="SettingEditor">
         <Border Style="{StaticResource Card}" Width="470">
            <DockPanel>
               <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
               <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Style="{StaticResource Hint}"/>
               <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisible}}">
                  <TextBlock Text="Picture" Style="{StaticResource Hint}"/>
                  <hshmwpfc:PixelImage DataContext="{Binding Preview}" UseTrueTransparency="True" HorizontalAlignment="Left"/>
               </StackPanel>
               <StackPanel>
                  <ContentControl Content="{Binding Options}" ContentTemplate="{StaticResource OptionPicker}" IsTabStop="False"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                     <TextBlock Text="{Binding NumberLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                     <TextBox Width="70" Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" KeyDown="NumberKeyDown"
                              ToolTip="The number the game uses. Type a number and press Enter, or choose from the list above."/>
                  </StackPanel>
                  <WrapPanel Margin="0,6,0,0">
                     <Button Content="Back to the original" Command="{Binding Reset}" Style="{StaticResource ToolButton}" ToolTip="Use the value this game had when this tab was opened"/>
                     <Button Content="Show in the main tab" Command="{Binding ShowInMainTab}" Style="{StaticResource ToolButton}" ToolTip="Show where the game's code stores this number"/>
                  </WrapPanel>
                  <Border Style="{StaticResource StatusBox}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisible}}">
                     <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                  </Border>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="11"/>
               </StackPanel>
            </DockPanel>
         </Border>
      </DataTemplate>

      <!-- the cards of the tab: each kind of card is drawn by its template -->
      <DataTemplate DataType="{x:Type hshmcvm:IntroSettingEditor}">
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingEditor}" IsTabStop="False" VerticalAlignment="Top"/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type hshmcvm:IntroSpawnEditor}">
            <Border Style="{StaticResource Card}" Width="470">
               <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"/>
                  <Border Style="{StaticResource StatusBox}" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisible}}">
                     <TextBlock Text="{Binding UnavailableMessage}" TextWrapping="Wrap" FontWeight="Bold"/>
                  </Border>
                  <StackPanel IsEnabled="{Binding IsAvailable}">
                     <TextBlock Text="Map" FontWeight="Bold" Margin="0,6,0,0"/>
                     <ContentControl Content="{Binding Maps}" ContentTemplate="{StaticResource OptionPicker}" IsTabStop="False"/>
                     <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="70" Text="{Binding XText, UpdateSourceTrigger=LostFocus}" KeyDown="NumberKeyDown"
                                 ToolTip="The tile to appear on, from left to right. -1 is the default of the truck. Type a number and press Enter."/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="70" Tag="Y" Text="{Binding YText, UpdateSourceTrigger=LostFocus}" KeyDown="NumberKeyDown"
                                 ToolTip="The tile to appear on, from top to bottom. -1 is the default of the truck. Type a number and press Enter."/>
                     </StackPanel>
                     <TextBlock Text="{Binding ShakeLabel}" Margin="0,10,0,0"/>
                     <WrapPanel Margin="0,4,0,0">
                        <Button Content="{Binding ToggleShakeText}" Command="{Binding ToggleShake}" Style="{StaticResource ToolButton}"
                                ToolTip="Switch the shaking of the moving truck during the new game intro on or off"/>
                        <Button Content="Back to the original" Command="{Binding Reset}" Style="{StaticResource ToolButton}" ToolTip="The truck, at -1, -1, shaking"/>
                        <Button Content="Show in the main tab" Command="{Binding ShowInMainTab}" Style="{StaticResource ToolButton}" ToolTip="Show where the ROM stores the spawn"/>
                     </WrapPanel>
                  </StackPanel>
                  <Border Style="{StaticResource StatusBox}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisible}}">
                     <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                  </Border>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="11"/>
               </StackPanel>
            </Border>
         </DataTemplate>
      <DataTemplate DataType="{x:Type hshmcvm:IntroPictureEditor}">
            <Border Style="{StaticResource Card}" Width="650">
            <StackPanel>
               <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
               <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left"/>
               <WrapPanel Margin="0,6,0,0">
                  <StackPanel Margin="0,0,24,6">
                     <TextBlock Text="In the game now" FontWeight="Bold"/>
                     <hshmwpfc:PixelImage DataContext="{Binding Current}" UseTrueTransparency="True" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                     <Button Content="Back to the original" Command="{Binding Restore}" Style="{StaticResource ToolButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                             ToolTip="Point the game at the picture it had when this tab was opened"/>
                     <Button Content="Show in the main tab" Command="{Binding ShowInMainTab}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left"
                             ToolTip="Show where the game's code points at the picture"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,24,6" Width="300">
                     <TextBlock Text="Choose a new picture" FontWeight="Bold"/>
                     <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <RadioButton Content="A Pokémon" IsChecked="{Binding UsePokemon}" GroupName="IntroPictureKind" Margin="0,0,12,0"
                                     Visibility="{Binding HasPokemon, Converter={StaticResource BoolToVisible}}"/>
                        <RadioButton Content="A trainer" IsChecked="{Binding UseTrainer}" GroupName="IntroPictureKind"
                                     Visibility="{Binding HasTrainers, Converter={StaticResource BoolToVisible}}"/>
                     </StackPanel>
                     <ContentControl Content="{Binding Active}" ContentTemplate="{StaticResource OptionPicker}" IsTabStop="False"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,6">
                     <TextBlock Text="How it will look" FontWeight="Bold"/>
                     <hshmwpfc:PixelImage DataContext="{Binding Candidate}" UseTrueTransparency="True" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                     <Button Content="Use this picture" Command="{Binding Apply}" Style="{StaticResource ToolButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                             ToolTip="Change the game's picture of the professor to this one (you can undo it)"/>
                  </StackPanel>
               </WrapPanel>
               <Border Style="{StaticResource StatusBox}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisible}}">
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
               </Border>
               <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="11"/>
            </StackPanel>
            </Border>
         </DataTemplate>
   </UserControl.Resources>

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Background}">
      <StackPanel Margin="12,8,2,8">

         <!-- ============ header ============ -->
         <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Refresh}" Padding="8,1" VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="Read everything from the ROM again"/>
            <StackPanel>
               <TextBlock Text="Intro Manager" FontSize="18"/>
               <TextBlock Text="{Binding Introduction}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left"
                          Visibility="{Binding Found, Converter={StaticResource BoolToVisible}}"/>
            </StackPanel>
         </DockPanel>

         <!-- ============ nothing found ============ -->
         <Border Style="{StaticResource Card}" Visibility="{Binding NotFound, Converter={StaticResource BoolToVisible}}" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel>
               <TextBlock Text="{Binding NotFoundMessage}" TextWrapping="Wrap"/>
            </StackPanel>
         </Border>

         <!-- ============ the cards: they sit side by side as far as the window is wide and wrap into one column in a narrow window ============ -->
         <ItemsControl ItemsSource="{Binding Cards}" IsTabStop="False" Visibility="{Binding Found, Converter={StaticResource BoolToVisible}}">
            <ItemsControl.ItemsPanel>
               <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
               </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
         </ItemsControl>

         <!-- ============ what was not found, and the limits ============ -->
         <Border Style="{StaticResource Card}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}" MaxWidth="780" HorizontalAlignment="Left" Background="#33FFB000">
            <StackPanel>
               <TextBlock Text="Not everything could be found" FontWeight="Bold"/>
               <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </StackPanel>
         </Border>
         <TextBlock Text="{Binding Limits}" Style="{StaticResource Hint}" MaxWidth="780" HorizontalAlignment="Left" Visibility="{Binding Found, Converter={StaticResource BoolToVisible}}"/>
      </StackPanel>
   </ScrollViewer>
</UserControl>
