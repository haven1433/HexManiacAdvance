                                                <DockPanel LastChildFill="True" Margin="2,2,2,0">
                                                   <Border DockPanel.Dock="Left" Width="96" Margin="2,0" Visibility="{Binding HasRowLabels, Converter={StaticResource BoolToVisibility}}"/>
                                                   <TextBlock DockPanel.Dock="Left" Width="44" Margin="2,0" Text="Chance" TextAlignment="Right" Foreground="{DynamicResource Secondary}"
