                                          </StackPanel>
                                          </Grid>
                                       </DataTemplate>
                                       <!-- a list of wild encounters: one row per pokemon, one box per value (min level, max level, species), so Tab walks across the row and down the list -->
                                       <DataTemplate DataType="{x:Type hsg3hvmtr:TableRowsStreamElementViewModel}">
                                          <Grid HorizontalAlignment="Stretch" Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
                                          <StackPanel ToolTip="{Binding ParentName}">
                                             <hsg3hv:CommonTableStreamControl />
                                             <StackPanel Margin="20,2,2,2" Background="{DynamicResource Backlight}"
