                                                   <Button Content="-" Command="{Binding DeletePage}" ToolTip="Delete the current page of this sprite and palette"/>
                                                </StackPanel>
                                                <hsg3hv:PixelImage SnapsToDevicePixels="True" />
                                             </DockPanel>
