                                       <DataTemplate DataType="{x:Type hsg3hvmtr:BitListArrayElementViewModel}">
                                          <Grid HorizontalAlignment="Stretch" Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
